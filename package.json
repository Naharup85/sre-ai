{
  "name": "sre-ai",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sre-ai/api db:generate",
    "db:migrate": "pnpm --filter @sre-ai/api db:migrate"
  },
  "engines": {
    "node": ">=20"
  }
}
